# =============================================================================
# ClearML Credentials
# =============================================================================
#
# Как получить credentials:
# 1. Зарегистрируйтесь на https://app.clear.ml (бесплатно)
# 2. Войдите в аккаунт
# 3. Перейдите в Settings -> Workspace -> Create new credentials
# 4. Скопируйте Access Key и Secret Key
#
# ВАЖНО: Не коммитьте .env файл в git!
# =============================================================================

# ClearML API endpoints (по умолчанию используется облачный сервис)
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml

# Ваши credentials (замените на реальные значения)
CLEARML_API_ACCESS_KEY=your_access_key_here
CLEARML_API_SECRET_KEY=your_secret_key_here
